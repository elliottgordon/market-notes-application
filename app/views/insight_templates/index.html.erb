<div class="section-header">
  <h1>My Insights</h1>
  <div class="generate-insights-area">
    <% if @notes_since_synthesis >= 5 %>
      <p class="synthesis-ready" style="margin-bottom: 0.4rem;"><%= @notes_since_synthesis %> new notes ready — time to synthesize</p>
    <% else %>
      <p class="synthesis-pending" style="margin-bottom: 0.4rem;"><%= @notes_since_synthesis %> of 5 notes until next synthesis</p>
    <% end %>
    <a href="/generate_insights" class="btn btn-accent">Generate New Insights</a>
  </div>
</div>

<hr>

<% @list_of_insights.each do |an_insight| %>
  <div class="card">
    <span class="badge <%= badge_class_for(an_insight.category) %>"><%= an_insight.category %></span>
    <h3><a href="/insights/<%= an_insight.id %>"><%= an_insight.title %></a></h3>
    <p><%= an_insight.body.to_s.truncate(150) %></p>
    <p class="card-meta"><%= an_insight.notes.count %> source notes &middot; Generated <%= time_ago_in_words(an_insight.created_at) %> ago</p>
  </div>
<% end %>

<div class="btn-group">
  <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>
