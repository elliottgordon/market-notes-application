<h1>Write New Market Note</h1>

<hr>

<form action="/notes" method="post">
  <div class="form-group">
    <label for="title_field">Title</label>
    <input id="title_field" type="text" name="query_title" placeholder="e.g. S&P rally on Fed comments">
  </div>

  <div class="form-group">
    <label for="market_date_field">Market Date</label>
    <input id="market_date_field" type="date" name="query_market_date">
  </div>

  <div class="form-group">
    <label for="body_field">Your Market Observations</label>
    <textarea id="body_field" name="query_body" placeholder="What did you observe in the market today? What are your beliefs? What happened?"></textarea>
  </div>

  <div class="btn-group">
    <button type="submit">Save Note</button>
    <a href="/notes" class="btn btn-secondary">Cancel</a>
  </div>
</form>