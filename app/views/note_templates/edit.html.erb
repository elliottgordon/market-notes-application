<h1>Edit Market Note</h1>

<hr>

<form action="/notes/<%= @the_note.id %>/update" method="post">
  <div class="form-group">
    <label for="title_field">Title</label>
    <input id="title_field" type="text" name="query_title" value="<%= @the_note.title %>">
  </div>

  <div class="form-group">
    <label for="market_date_field">Market Date</label>
    <input id="market_date_field" type="date" name="query_market_date" value="<%= @the_note.market_date %>">
  </div>

  <div class="form-group">
    <label for="body_field">Your Market Observations</label>
    <textarea id="body_field" name="query_body"><%= @the_note.body %></textarea>
  </div>

  <div class="btn-group">
    <button type="submit">Update Note</button>
    <a href="/notes/<%= @the_note.id %>" class="btn btn-secondary">Cancel</a>
  </div>
</form>