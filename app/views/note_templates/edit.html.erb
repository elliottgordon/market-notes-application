<h1>Edit Market Note</h1>

<hr>

<form action="/notes/<%= @the_note.id %>/update" method="post">
  <div class="form-group">
    <label for="title_field">Title</label>
    <input id="title_field" type="text" name="query_title" value="<%= @the_note.title %>">
  </div>

  <div class="form-group">
    <label for="market_date_field">Market Date</label>
    <input id="market_date_field" type="date" name="query_market_date" value="<%= @the_note.market_date %>">
  </div>

  <div class="note-section-group">
    <div class="form-group">
      <label for="section_what_moved">What Moved</label>
      <p class="section-hint">The 2–3 most notable moves in rates, curve, or adjacent markets today. Include levels and magnitudes, not just direction.</p>
      <textarea id="section_what_moved" name="note[what_moved]" style="min-height: 80px;"><%= @sections[:what_moved] %></textarea>
    </div>
  </div>

  <div class="note-section-group">
    <div class="form-group">
      <label for="section_why_moved">Why It Moved</label>
      <p class="section-hint">Your best understanding of the driver — news, data, supply, positioning, technical levels.</p>
      <textarea id="section_why_moved" name="note[why_moved]" style="min-height: 80px;"><%= @sections[:why_moved] %></textarea>
    </div>
  </div>

  <div class="note-section-group">
    <div class="form-group">
      <label for="section_surprised">What Surprised You</label>
      <p class="section-hint">The one thing that didn't behave the way you expected. This is where learning lives.</p>
      <textarea id="section_surprised" name="note[surprised]" style="min-height: 80px;"><%= @sections[:surprised] %></textarea>
    </div>
  </div>

  <div class="note-section-group">
    <div class="form-group">
      <label for="section_thesis">Connection to Your Thesis</label>
      <p class="section-hint">Does today confirm, challenge, or modify your running view? One sentence is fine.</p>
      <textarea id="section_thesis" name="note[thesis]" style="min-height: 50px;"><%= @sections[:thesis] %></textarea>
    </div>
  </div>

  <div class="note-section-group">
    <div class="form-group">
      <label for="section_open_question">Open Question</label>
      <p class="section-hint">Something you noticed but can't explain yet.</p>
      <textarea id="section_open_question" name="note[open_question]" style="min-height: 50px;"><%= @sections[:open_question] %></textarea>
    </div>
  </div>

  <div class="btn-group">
    <button type="submit">Update Note</button>
    <a href="/notes/<%= @the_note.id %>" class="btn btn-secondary">Cancel</a>
  </div>
</form>
