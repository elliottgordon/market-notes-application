<h1>Edit Profile</h1>

<hr>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <% if resource.errors.any? %>
    <div class="flash flash-alert">
      <% resource.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <label for="user_username">Username</label>
    <%= f.text_field :username, id: "user_username", autofocus: true %>
  </div>

  <div class="form-group">
    <label for="user_email">Email</label>
    <%= f.email_field :email, id: "user_email", autocomplete: "email" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <p class="detail-meta">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
  <% end %>

  <hr>
  <p class="detail-meta">Leave password fields blank if you don't want to change it.</p>

  <div class="form-group">
    <label for="user_password">New password</label>
    <%= f.password_field :password, id: "user_password", autocomplete: "new-password" %>
  </div>

  <div class="form-group">
    <label for="user_password_confirmation">Confirm new password</label>
    <%= f.password_field :password_confirmation, id: "user_password_confirmation", autocomplete: "new-password" %>
  </div>

  <hr>
  <p class="detail-meta">We need your current password to confirm changes.</p>

  <div class="form-group">
    <label for="user_current_password">Current password</label>
    <%= f.password_field :current_password, id: "user_current_password", autocomplete: "current-password" %>
  </div>

  <div class="btn-group">
    <%= f.submit "Update Profile" %>
    <a href="/dashboard" class="btn btn-secondary">Cancel</a>
  </div>
<% end %>

<hr>

<h2>Danger Zone</h2>
<div class="card" style="border-color: #f85149;">
  <p>Permanently delete your account and all your data.</p>
  <%= button_to "Delete My Account", registration_path(resource_name), method: :delete, data: { confirm: "Are you sure? This cannot be undone." }, class: "btn btn-danger" %>
</div>