<h1>Sign Up</h1>

<hr>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <% if resource.errors.any? %>
    <div class="flash flash-alert">
      <% resource.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <label for="user_username">Username</label>
    <%= f.text_field :username, id: "user_username", autofocus: true %>
  </div>

  <div class="form-group">
    <label for="user_email">Email</label>
    <%= f.email_field :email, id: "user_email", autocomplete: "email" %>
  </div>

  <div class="form-group">
    <label for="user_password">Password <span class="detail-meta">(6 characters minimum)</span></label>
    <%= f.password_field :password, id: "user_password", autocomplete: "new-password" %>
  </div>

  <div class="form-group">
    <label for="user_password_confirmation">Confirm password</label>
    <%= f.password_field :password_confirmation, id: "user_password_confirmation", autocomplete: "new-password" %>
  </div>

  <div class="btn-group">
    <%= f.submit "Sign Up" %>
  </div>
<% end %>

<hr>

<p class="detail-meta">
  Already have an account? <a href="/users/sign_in">Sign In</a>
</p>